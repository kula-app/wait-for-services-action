{
  "name": "@kula.app/wait-for-services-action",
  "version": "1.0.0",
  "description": "GitHub Action sub-actions to wait for various services to be ready",
  "main": "src/index.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "all": "yarn format && yarn lint && yarn test && yarn build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kula-app/wait-for-services-action.git"
  },
  "keywords": [
    "actions",
    "services",
    "wait",
    "health-check"
  ],
  "author": "kula.app",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.2.0",
    "nats": "^2.29.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
